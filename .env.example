# Anthropic (required for Claude scorer fallback)
ANTHROPIC_API_KEY=sk-ant-...

# TypeSafe Jev — primary scorer; get a key at https://typesafe.ai
TYPESAFE_API_KEY=

# JSearch via RapidAPI — covers LinkedIn, Indeed, Glassdoor, ZipRecruiter
# Free tier: 10 req/day. Basic paid: ~$10/month for 500 req/day.
# https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=

# Adzuna — broad job board (US + international)
# Free tier available: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_API_KEY=

# Storage paths (optional — defaults: rolescout.db, resume.md)
# DB_PATH=rolescout.db
# RESUME_PATH=resume.md
