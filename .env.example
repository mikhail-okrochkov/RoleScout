# Required
ANTHROPIC_API_KEY=sk-ant-...

# JSearch via RapidAPI — covers LinkedIn, Indeed, Glassdoor, ZipRecruiter
# Free tier: 10 req/day. Basic paid: ~$10/month for 500 req/day.
# https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=

# Adzuna — broad job board (US + international)
# Free tier available: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_API_KEY=

# Job search parameters
TARGET_ROLE=Staff Data Scientist
TARGET_ROLES=["Staff Data Scientist", "Principal Data Scientist", "Lead Data Scientist", "Head of AI", "Director of Data Science", "Principal Machine Learning Engineer", "Senior Machine Learning Engineer"]
TARGET_LOCATION=Remote
TARGET_SALARY_MIN=180000
TARGET_SALARY_MAX=280000

# Location scoring tiers (JSON arrays)
# Tier 1 — full score (remote jobs always score 1.0 regardless of these)
# Bay Area: include both "San Francisco" and "Bay Area" to match common listing formats
PREFERRED_LOCATIONS=["Seattle", "San Francisco", "Bay Area", "San Diego"]
# Tier 2 — partial score (0.6); good only if compensation is strong
ACCEPTABLE_LOCATIONS=["Boston"]

# Pre-score filters — jobs matching any keyword (title or description) are dropped
# Extend this list with anything else you never want to see
EXCLUDE_KEYWORDS=["security clearance", "clearance required", "active clearance", "secret clearance", "top secret", "ts/sci", "ts / sci", "dod clearance", "clearance preferred"]

# Distance radius (miles) around each preferred/acceptable city — default 50
# Fairfax VA (~15mi from DC) and similar suburbs are included automatically
# LOCATION_RADIUS_MILES=50

# Storage
DB_PATH=rolescout.db

# How many jobs per Claude API call (10 is a good balance of cost vs accuracy)
BATCH_SIZE=10
